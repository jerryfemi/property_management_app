{
    "compilerOptions": {
        "module": "commonjs",
        "target": "es2020",
        "outDir": "lib",
        "rootDir": "src",
        "strict": true,
        "noImplicitReturns": true,
        "noFallthroughCasesInSwitch": true,
        "sourceMap": true,
        "esModuleInterop": true,
        "types": ["node"]
    },
    "compileOnSave": true,
    "include": [
        "src"
    ]
}